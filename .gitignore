# Server environment — contains secrets, never commit
.htaccess
# Allow lab access-control .htaccess files (no secrets, just headers/Require rules)
!lab/.htaccess
!lab/*/.htaccess
# Honeytoken routing .htaccess (no secrets, just rewrite rules for /c/ and /t/)
!c/.htaccess
!t/.htaccess

# Runtime data
github_cache.json
youtube_cache.json
rate_limits/
visitor_count.txt
click_count.txt
visitor_locations.json
active_visitors/
counter_migrated.txt
chat_messages.json
cursor_data.json
place_data/
world_data.json
activity_feed.json

# Pwn lab runtime data
lab/data/sessions.json
lab/data/leaderboard.json

# Game leaderboard runtime data
game/data/

# Videos section runtime data — never commit the SQLite DB or user uploads,
# but DO keep the hardening .htaccess files that ship with the section.
videos/data/*
videos/media/*
videos/thumbs/*
videos/avatars/*
!videos/data/.htaccess
!videos/media/.htaccess
!videos/thumbs/.htaccess
!videos/avatars/.htaccess

# Local Claude Code tooling (launch configs, settings) — not part of the site
.claude/

# Crackme source (private)
crackmes/

# Jellyfin dashboard secrets — never commit the server URL + API key
jellyfin/config.php
# Stack status snapshots pushed by the media-server agent (keep the deny .htaccess)
jellyfin/data/*
!jellyfin/data/.htaccess

# Threat map runtime cache (aggregated public feeds) — keep the deny .htaccess
threatmap/data/*
!threatmap/data/.htaccess

# OSINT tool user store (accounts + invite codes) — keep the deny .htaccess
osint/data/*
!osint/data/.htaccess
# OSINT optional API keys (EmailRep / HIBP / Intelligence X) — never commit; example is tracked
osint/config.local.php

# Owner console secrets (password hash + #security webhook) — never commit
owner/config.php
# Audit-log SQLite (runtime) — keep the deny .htaccess
owner/data/*
!owner/data/.htaccess
